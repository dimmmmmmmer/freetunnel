# Data that the desktop and the Android app use alike, kept in one file under data/.
#
# Today that is two lists under data/split/:
#   recommended-russia.txt      the list behind "Recommended for Russia";
#   default-excluded-routes.txt the excluded routes a new installation starts with, and that
#                               "Restore defaults" in Settings puts back.
# Each is turned into an include file of QStringLiteral entries, which src/core/AppSettings.cpp
# includes inside the braces of recommendedRussiaDomains() and defaultExcludedRoutes().
# Compiled in, so that src/core needs no resource file and a test or a tool that links
# AppSettings.cpp gets the lists with it. The Android app copies the same files into its
# assets (android/app/build.gradle).
#
# Included by the root CMakeLists.txt and by tests/CMakeLists.txt, which is a project of
# its own, before any target is made: the directory it generates into is added to the
# include path of every target in the including directory.
#
# The files' format is described at the top of each: one entry per line, UTF-8, blank lines
# and lines starting with # ignored, no comment after an entry.

set(_FT_DATA_DIR "${CMAKE_CURRENT_LIST_DIR}/../data")
set(_FT_SHARED_DATA_OUT "${CMAKE_CURRENT_BINARY_DIR}/ft_shared_data")

# freetunnel_rule_list_include(<list file> <include file>)
#
# Writes <include file> with one `QStringLiteral("entry"),` line for each entry in <list
# file>. The include file is rewritten only when its text changes, so that configuring
# again does not recompile what includes it; and the list file is a configure
# dependency, so that editing it configures again.
function(freetunnel_rule_list_include list_file include_file)
    if(NOT EXISTS "${list_file}")
        message(FATAL_ERROR "SharedData: ${list_file} is missing")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${list_file}")

    # A byte order mark would end up inside the first rule.
    file(READ "${list_file}" first_bytes HEX LIMIT 3)
    if(first_bytes STREQUAL "efbbbf")
        message(FATAL_ERROR "SharedData: ${list_file} begins with a byte order mark; write UTF-8 without one")
    endif()

    file(READ "${list_file}" text)
    string(REPLACE "\r" "" text "${text}")
    # Whole-line comments go first: they are free text, and may hold what an entry may not.
    string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\\1" text "${text}")
    # What would break out of a C++ string, or out of a CMake list.
    if(text MATCHES "[\"\\\\;$`]" OR text MATCHES "\\[" OR text MATCHES "\\]")
        message(FATAL_ERROR "SharedData: an entry in ${list_file} holds one of \" \\ ; $ ` [ ], which no entry does")
    endif()

    string(REPLACE "\n" ";" lines "${text}")
    set(body "")
    set(count 0)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" entry)
        if(entry STREQUAL "")
            continue()
        endif()
        string(APPEND body "    QStringLiteral(\"${entry}\"),\n")
        math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
        message(FATAL_ERROR "SharedData: ${list_file} lists no entry")
    endif()

    get_filename_component(list_name "${list_file}" NAME)
    set(generated "// Generated by cmake/SharedData.cmake from data/split/${list_name}. Do not edit.\n${body}")
    set(current "")
    if(EXISTS "${include_file}")
        file(READ "${include_file}" current)
    endif()
    if(NOT current STREQUAL generated)
        get_filename_component(dir "${include_file}" DIRECTORY)
        file(MAKE_DIRECTORY "${dir}")
        file(WRITE "${include_file}" "${generated}")
    endif()
    message(STATUS "SharedData: ${count} entries from ${list_file}")
endfunction()

freetunnel_rule_list_include("${_FT_DATA_DIR}/split/recommended-russia.txt"
                             "${_FT_SHARED_DATA_OUT}/recommended_russia.inc")
freetunnel_rule_list_include("${_FT_DATA_DIR}/split/default-excluded-routes.txt"
                             "${_FT_SHARED_DATA_OUT}/default_excluded_routes.inc")
include_directories("${_FT_SHARED_DATA_OUT}")
