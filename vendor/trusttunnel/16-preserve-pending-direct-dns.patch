+
+class FreeTunnelPendingDirectDns : public DnsRoutingBase, public testing::WithParamInterface<bool> {};
+
+TEST_P(FreeTunnelPendingDirectDns, EndpointRecoveryPreservesPendingDirectQueryAndBlocksVpnQuery) {
+    const bool tcp = GetParam();
+    vpn.kill_switch_on = true;
+    vpn.update_exclusions(VPN_MODE_GENERAL, "direct.example");
+    ClientConnectRequest event = {client_id, tcp ? IPPROTO_TCP : IPPROTO_UDP, &src, &dst};
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+    vpn.tunnel->complete_connect_request(client_id, VPN_CA_DEFAULT);
+    run_event_loop_once();
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &client_id);
+    auto send_question = [&](std::string_view domain) {
+        auto encoded = dns_utils::encode_request({dns_utils::RT_A, domain});
+        ASSERT_TRUE(std::holds_alternative<dns_utils::EncodedRequest>(encoded));
+        const auto &request = std::get<dns_utils::EncodedRequest>(encoded);
+        std::vector<uint8_t> wire;
+        if (tcp) {
+            wire.push_back(uint8_t(request.data.size() >> 8));
+            wire.push_back(uint8_t(request.data.size()));
+        }
+        wire.insert(wire.end(), request.data.begin(), request.data.end());
+        ClientRead read = {client_id, wire.data(), wire.size(), 0};
+        vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+        ASSERT_EQ(read.result, int(wire.size()));
+    };
+    mock_system_dns_server->expect({
+            .request = MockDnsServer::Request{.tcp = tcp, .qtype = 1, .qname = "direct.example."},
+            .response = MockDnsServer::Response{},
+    });
+    ASSERT_NO_FATAL_FAILURE(send_question("direct.example"));
+    // The direct query is in flight while the endpoint disappears. Keeping the
+    // app's DNS transport must not let a later VPN-domain query bypass the VPN.
+    vpn.tunnel->on_before_endpoint_disconnect(redirect_upstream.get());
+    vpn.tunnel->upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_CLOSED, nullptr);
+    vpn.tunnel->on_after_endpoint_disconnect(redirect_upstream.get());
+    ASSERT_TRUE(client_listener->connections.contains(client_id));
+    ASSERT_NO_FATAL_FAILURE(send_question("vpn.example"));
+    ASSERT_TRUE(vpn.tunnel->update_dns_handler_parameters());
+    vpn_event_loop_exit(ev_loop.get(), DEFAULT_TIMEOUT);
+    vpn_event_loop_run(ev_loop.get());
+    EXPECT_EQ(system_complete, 1);
+    EXPECT_EQ(system_unexpected, 0);
+    EXPECT_TRUE(redirect_upstream->connections.empty());
+    const auto &connections = client_listener->connections.contains(client_id) ? client_listener->connections
+                                                                               : client_listener->closed_connections;
+    ASSERT_TRUE(connections.contains(client_id));
+    EXPECT_TRUE(connections.at(client_id).last_send.has_value());
+}
+
+INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelPendingDirectDns, testing::Bool());
