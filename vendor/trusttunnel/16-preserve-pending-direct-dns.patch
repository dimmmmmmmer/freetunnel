@@ -1485,8 +1485,14 @@ void Tunnel::on_before_endpoint_disconnect(ServerUpstream *upstream) {
         // Only the endpoint is going away. Keep independently routed sockets
         // alive, including direct connections still waiting for their peer.
         // Unclassified/migrating flows must not inherit a direct route here.
+        // The application's plain-DNS channel is independent of the endpoint
+        // too. Its handler routes every question separately and enforces the
+        // kill switch for VPN domains. Closing it here loses in-flight direct
+        // answers (and every question multiplexed on a TCP DNS connection).
