diff --git a/core/test/test_dns_routing.cpp b/core/test/test_dns_routing.cpp
index f4a2a7f..ea3344d 100644
--- a/core/test/test_dns_routing.cpp
+++ b/core/test/test_dns_routing.cpp
@@ -1474,3 +1474,90 @@ INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelDisconnectedDns,
                         CanonicalDnsSample{VPN_MODE_GENERAL, "@0:vpn.example @3:*.example", "vpn.example", true},
                         CanonicalDnsSample{VPN_MODE_SELECTIVE, "@0:vpn.example @3:*.example", "vpn.example", true}),
                 testing::Bool()));
+
+// Hostnames learned from one TCP flow are hints about an address, not the
+// identity of every future connection to the same CDN address and application.
+class FreeTunnelSharedAddress
+        : public DnsRoutingBase,
+          public testing::WithParamInterface<std::tuple<bool, bool, bool, bool, bool, bool, bool>> {};
+
+TEST_P(FreeTunnelSharedAddress, ClassifiesEachNewConnectionBeforeSendingPayload) {
+    const auto [ipv6, selective, policy_rules, direct, opaque, other_available, endpoint_down] = GetParam();
+    const auto mode = selective ? VPN_MODE_SELECTIVE : VPN_MODE_GENERAL;
+    const std::string rules = policy_rules ? "@1:direct.example @0:vpn.example"
+            : selective                    ? "vpn.example"
+                                           : "direct.example";
+    vpn.update_exclusions(mode, rules);
+    vpn.exclusions_scannable_ports = ag::parse_scannable_ports("80,443").value();
+    const SocketAddress shared(ipv6 ? "2001:db8::1" : "192.0.2.1", 80);
+    const bool expected_direct = opaque ? selective : direct;
+    if (endpoint_down) {
+        vpn.kill_switch_on = true;
+        vpn.tunnel->on_before_endpoint_disconnect(redirect_upstream.get());
+        vpn.tunnel->upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_CLOSED, nullptr);
+        vpn.tunnel->on_after_endpoint_disconnect(redirect_upstream.get());
+    }
+    if (!other_available) {
+        (expected_direct ? redirect_upstream : bypass_upstream)->ip_version_availability.reset();
+    }
+    if (ipv6) {
+        src = SocketAddress("[2001:db8::2]:42");
+    }
+    vpn.domain_filter.add_resolved_tag({shared, "browser"}, expected_direct ? "vpn.example" : "direct.example");
+    const TunnelAddress destination = shared;
+    uint64_t id = vpn.listener_conn_id_generator.get();
+    ClientConnectRequest event = {id, IPPROTO_TCP, &src, &destination};
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+    const auto action = vpn.tunnel->finalize_connect_action({.id = id, .action = VPN_CA_DEFAULT, .appname = "browser"});
+    if (endpoint_down) {
+        ASSERT_TRUE(vpn.tunnel->should_complete_immediately(id))
+                << "Hostname classification must not wait for the VPN endpoint";
+    }
+    vpn.tunnel->complete_connect_request(id, action);
+    run_event_loop_once();
+    ASSERT_TRUE(bypass_upstream->connections.empty()) << "Previous hostname caused a premature direct connection";
+    ASSERT_TRUE(redirect_upstream->connections.empty()) << "Current hostname has not been inspected yet";
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &id);
+    const std::string request = opaque
+            ? "SSH-2.0-OpenSSH_9.9\r\n"
+            : AG_FMT("GET / HTTP/1.1\r\nHost: {}\r\n\r\n", direct ? "direct.example" : "vpn.example");
+    ClientRead read = {id, reinterpret_cast<const uint8_t *>(request.data()), request.size(), 0};
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+    EXPECT_EQ(expected_direct ? 1 : 0, bypass_upstream->connections.size());
+    EXPECT_EQ(expected_direct || endpoint_down ? 0 : 1, redirect_upstream->connections.size());
+    if (endpoint_down && !expected_direct) {
+        EXPECT_LT(read.result, 0);
+    }
+}
+
+INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelSharedAddress,
+        testing::Combine(testing::Bool(), testing::Bool(), testing::Bool(), testing::Bool(), testing::Bool(),
+                testing::Bool(), testing::Bool()));
+
+TEST_F(DnsRoutingBase, FreeTunnelUnavailableSelectedFamilyNeverFallsBackToOtherRoute) {
+    for (bool selective : {false, true}) {
+        vpn.update_exclusions(selective ? VPN_MODE_SELECTIVE : VPN_MODE_GENERAL, "@0:vpn.example @1:direct.example");
+        vpn.exclusions_scannable_ports = ag::parse_scannable_ports("80").value();
+        for (bool direct : {false, true}) {
+            redirect_upstream->ip_version_availability.set();
+            bypass_upstream->ip_version_availability.set();
+            (direct ? bypass_upstream : redirect_upstream)->ip_version_availability.reset();
+            const TunnelAddress destination = SocketAddress("[2001:db8::1]:80");
+            uint64_t id = vpn.listener_conn_id_generator.get();
+            ClientConnectRequest event = {id, IPPROTO_TCP, &src, &destination};
+            vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+            const auto action = vpn.tunnel->finalize_connect_action({.id = id, .action = VPN_CA_DEFAULT});
+            vpn.tunnel->complete_connect_request(id, action);
+            run_event_loop_once();
+            vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &id);
+            const auto request =
+                    AG_FMT("GET / HTTP/1.1\r\nHost: {}\r\n\r\n", direct ? "direct.example" : "vpn.example");
+            ClientRead read = {id, reinterpret_cast<const uint8_t *>(request.data()), request.size(), 0};
+            vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+            EXPECT_LT(read.result, 0);
+            EXPECT_TRUE(bypass_upstream->connections.empty());
+            EXPECT_TRUE(redirect_upstream->connections.empty());
+            run_event_loop_once();
+        }
+    }
+}
