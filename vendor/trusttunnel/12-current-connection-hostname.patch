+// Hostnames learned from one TCP flow are hints about an address, not the
+// identity of every future connection to the same CDN address and application.
+class FreeTunnelSharedAddress : public DnsRoutingBase,
+                                public testing::WithParamInterface<std::tuple<bool, bool, bool, bool, bool, bool>> {};
+
+TEST_P(FreeTunnelSharedAddress, ClassifiesEachNewConnectionBeforeSendingPayload) {
+    const auto [ipv6, selective, policy_rules, direct, opaque, other_available] = GetParam();
+    const auto mode = selective ? VPN_MODE_SELECTIVE : VPN_MODE_GENERAL;
+    const std::string rules = policy_rules ? "@1:direct.example @0:vpn.example"
+            : selective                    ? "vpn.example"
+                                           : "direct.example";
+    vpn.update_exclusions(mode, rules);
+    vpn.exclusions_scannable_ports = ag::parse_scannable_ports("80,443").value();
+    const SocketAddress shared(ipv6 ? "2001:db8::1" : "192.0.2.1", 80);
+    const bool expected_direct = opaque ? selective : direct;
+    if (!other_available) {
+        (expected_direct ? redirect_upstream : bypass_upstream)->ip_version_availability.reset();
+    }
+    if (ipv6) {
+        src = SocketAddress("[2001:db8::2]:42");
+    }
+    vpn.domain_filter.add_resolved_tag({shared, "browser"}, expected_direct ? "vpn.example" : "direct.example");
+    const TunnelAddress destination = shared;
+    uint64_t id = vpn.listener_conn_id_generator.get();
+    ClientConnectRequest event = {id, IPPROTO_TCP, &src, &destination};
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+    const auto action = vpn.tunnel->finalize_connect_action({.id = id, .action = VPN_CA_DEFAULT, .appname = "browser"});
+    vpn.tunnel->complete_connect_request(id, action);
+    run_event_loop_once();
+    ASSERT_TRUE(bypass_upstream->connections.empty()) << "Previous hostname caused a premature direct connection";
+    ASSERT_TRUE(redirect_upstream->connections.empty()) << "Current hostname has not been inspected yet";
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &id);
+    const std::string request = opaque
+            ? "SSH-2.0-OpenSSH_9.9\r\n"
+            : AG_FMT("GET / HTTP/1.1\r\nHost: {}\r\n\r\n", direct ? "direct.example" : "vpn.example");
+    ClientRead read = {id, reinterpret_cast<const uint8_t *>(request.data()), request.size(), 0};
+    vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+    EXPECT_EQ(expected_direct ? 1 : 0, bypass_upstream->connections.size());
+    EXPECT_EQ(expected_direct ? 0 : 1, redirect_upstream->connections.size());
+}
