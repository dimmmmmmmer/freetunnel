diff --git a/core/test/test_domain_filter.cpp b/core/test/test_domain_filter.cpp
index 8ef587f..e3b6b79 100644
--- a/core/test/test_domain_filter.cpp
+++ b/core/test/test_domain_filter.cpp
@@ -300,3 +300,42 @@ TEST(MatchTest, FreeTunnelTomlRulesPrecedeGeoLists) {
     EXPECT_EQ(filter.match_domain("example.com"), DFMS_EXCLUSION);
     EXPECT_EQ(filter.match_domain("other.com"), DFMS_DEFAULT);
 }
+
+// Names learned from traffic belong to the parent filter. An IP match must not
+// hide them, even after updating a geo list (which rebuilds the child filters).
+TEST(MatchTest, FreeTunnelIpPoliciesKeepKnownHostnames) {
+    for (const auto *address : {"192.0.2.10", "2001:db8::10"}) {
+        for (VpnMode mode : {VPN_MODE_GENERAL, VPN_MODE_SELECTIVE}) {
+            for (int tier : {0, 1, 2, 3}) {
+                DomainFilter filter;
+                const std::string rules = "@" + std::to_string(tier) + ":192.0.2.0/24 @"
+                        + std::to_string(tier) + ":2001:db8::/32";
+                ASSERT_TRUE(filter.update_exclusions(mode, rules));
+                SockAddrTag tag{SocketAddress(address, 443)};
+                const auto before = filter.match_tag(tag);
+                EXPECT_FALSE(before.domain.has_value());
+                filter.add_resolved_tag(tag, "service.example");
+                ASSERT_TRUE(filter.update_exclusions(mode, rules));
+                const auto after = filter.match_tag(tag);
+                EXPECT_EQ(after.status, before.status);
+                ASSERT_TRUE(after.domain.has_value());
+                EXPECT_EQ(*after.domain, "service.example");
+                // A hostname for another port must not be invented from this one.
+                EXPECT_FALSE(filter.match_tag(SockAddrTag{SocketAddress(address, 8443)}).domain.has_value());
+            }
+        }
+    }
+}
+
+TEST(MatchTest, FreeTunnelLegacyIpRulesKeepKnownHostnames) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "192.0.2.0/24 2001:db8::/32"));
+    for (const auto *address : {"192.0.2.10", "2001:db8::10"}) {
+        SockAddrTag tag{SocketAddress(address, 443)};
+        filter.add_resolved_tag(tag, "service.example");
+        const auto match = filter.match_tag(tag);
+        EXPECT_EQ(match.status, DFMS_EXCLUSION);
+        ASSERT_TRUE(match.domain.has_value());
+        EXPECT_EQ(*match.domain, "service.example");
+    }
+}
