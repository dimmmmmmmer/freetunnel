+// A disconnected endpoint must not disable DNS for destinations explicitly
+// routed around it. VPN destinations still fail closed while the kill switch is on.
+class FreeTunnelDisconnectedDns : public DnsRoutingBase,
+                                  public testing::WithParamInterface<std::tuple<CanonicalDnsSample, bool>> {
+public:
+    void SetUp() override {
+        vpn.listener_config.dns_alt_exclusions_route = std::get<1>(GetParam());
+        DnsRoutingBase::SetUp();
+        vpn.kill_switch_on = true;
+        vpn.tunnel->on_before_endpoint_disconnect(redirect_upstream.get());
+        vpn.tunnel->upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_CLOSED, nullptr);
+        vpn.tunnel->on_after_endpoint_disconnect(redirect_upstream.get());
+    }
+};
+
+TEST_P(FreeTunnelDisconnectedDns, KeepsBypassAvailableAndVpnBlocked) {
+    const auto [sample, alt_route] = GetParam();
+    const auto [mode, rules, domain, through_vpn] = sample;
+    vpn.update_exclusions(mode, rules);
+    ASSERT_NO_FATAL_FAILURE(open_connection());
+    if (!through_vpn && !alt_route) {
+        mock_system_dns_server->expect({
+                .request = MockDnsServer::Request{.tcp = false, .qtype = 1, .qname = AG_FMT("{}.", domain)},
+                .response = MockDnsServer::Response{},
+        });
+    }
+    ASSERT_NO_FATAL_FAILURE(raise_dns_request(domain));
+    vpn_event_loop_exit(ev_loop.get(), !through_vpn && !alt_route ? DEFAULT_TIMEOUT : Millis{500});
+    vpn_event_loop_run(ev_loop.get());
+    EXPECT_EQ(0, redirect_upstream->connections.size());
+    EXPECT_EQ(0, system_unexpected);
+    EXPECT_EQ(!through_vpn && !alt_route ? 1 : 0, system_complete);
+    EXPECT_EQ(!through_vpn && alt_route ? 1 : 0, bypass_upstream->connections.size());
+    if (!through_vpn && alt_route) {
+        EXPECT_EQ(dst, bypass_upstream->last_destination);
+    }
+}
+
+INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelDisconnectedDns,
+        testing::Combine(
+                testing::Values(CanonicalDnsSample{VPN_MODE_GENERAL, "bypass.example", "ByPaSs.ExAmPlE", false},
+                        CanonicalDnsSample{VPN_MODE_GENERAL, "bypass.example", "vpn.example", true},
+                        CanonicalDnsSample{VPN_MODE_SELECTIVE, "vpn.example", "direct.example", false},
+                        CanonicalDnsSample{VPN_MODE_SELECTIVE, "vpn.example", "VpN.ExAmPlE", true},
+                        CanonicalDnsSample{VPN_MODE_GENERAL, "@1:direct.example @2:*.example", "direct.example", false},
+                        CanonicalDnsSample{
+                                VPN_MODE_SELECTIVE, "@1:direct.example @2:*.example", "direct.example", false},
+                        CanonicalDnsSample{VPN_MODE_GENERAL, "@0:vpn.example @3:*.example", "vpn.example", true},
+                        CanonicalDnsSample{VPN_MODE_SELECTIVE, "@0:vpn.example @3:*.example", "vpn.example", true}),
+                testing::Bool()));
