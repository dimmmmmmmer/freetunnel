+// FreeTunnel policy prefixes are generated by the application, not shown in UI.
+TEST(MatchTest, FreeTunnelManualRulesPrecedeGeoRules) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL,
+            "@0:*.example.com @3:*.com @1:direct.example.net @2:*.example.net"));
+    EXPECT_EQ(filter.match_domain("sub.example.com"), DFMS_DEFAULT);
+    EXPECT_EQ(filter.match_domain("other.com"), DFMS_EXCLUSION);
+    EXPECT_EQ(filter.match_domain("direct.example.net"), DFMS_EXCLUSION);
+    EXPECT_EQ(filter.match_domain("other.example.net"), DFMS_DEFAULT);
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_SELECTIVE,
+            "@0:*.example.com @3:*.com @1:direct.example.net @2:*.example.net"));
+    EXPECT_EQ(filter.match_domain("sub.example.com"), DFMS_EXCLUSION);
+    EXPECT_EQ(filter.match_domain("other.com"), DFMS_DEFAULT);
+    EXPECT_EQ(filter.match_domain("direct.example.net"), DFMS_DEFAULT);
+    EXPECT_EQ(filter.match_domain("other.example.net"), DFMS_EXCLUSION);
+}
+
+TEST(MatchTest, FreeTunnelManualDomainOverridesGeoSubnet) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "@0:example.com @3:192.0.2.0/24"));
+    SockAddrTag tag{SocketAddress("192.0.2.10", 443)};
+    filter.add_resolved_tag(tag, "example.com");
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_DEFAULT);
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "@1:example.com @2:192.0.2.0/24"));
+    // Updating lists must not discard a domain already learned from traffic.
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_EXCLUSION);
+}
+
+TEST(MatchTest, FreeTunnelPolicyRejectsNestedEntriesAndClearsOldRules) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "@0:@3:example.com @3:other.com"));
+    EXPECT_EQ(filter.match_domain("example.com"), DFMS_DEFAULT);
+    EXPECT_EQ(filter.match_domain("other.com"), DFMS_EXCLUSION);
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, ""));
+    EXPECT_EQ(filter.match_domain("other.com"), DFMS_DEFAULT);
+}
+
+TEST(MatchTest, FreeTunnelDefersGeoSubnetUntilManualDomainIsKnown) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "@0:*.example.com @3:192.0.2.0/24"));
+    SockAddrTag tag{SocketAddress("192.0.2.10", 443)};
+    EXPECT_EQ(filter.match_tag(tag, true).status, DFMS_SUSPECT_EXCLUSION);
+    // Unscannable traffic and a failed hostname lookup use the IP rule.
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_EXCLUSION);
+    filter.add_resolved_tag(tag, "sub.example.com");
+    EXPECT_EQ(filter.match_tag(tag, true).status, DFMS_DEFAULT);
+    filter.add_resolved_tag(tag, "other.net");
+    EXPECT_EQ(filter.match_tag(tag, true).status, DFMS_EXCLUSION);
+}
+
+TEST(MatchTest, FreeTunnelManualIpPrecedesGeoDomainWithoutDeferral) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "@1:192.0.2.0/24 @2:*.example.com"));
+    SockAddrTag tag{SocketAddress("192.0.2.10", 443)};
+    EXPECT_EQ(filter.match_tag(tag, true).status, DFMS_EXCLUSION);
+    filter.add_resolved_tag(tag, "sub.example.com");
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_EXCLUSION);
+}
+
+TEST(MatchTest, FreeTunnelSelectiveModeDefersGeoIpForManualBypassDomain) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_SELECTIVE, "@1:*.example.com @2:192.0.2.0/24"));
+    SockAddrTag tag{SocketAddress("192.0.2.10", 443)};
+    EXPECT_EQ(filter.match_tag(tag, true).status, DFMS_SUSPECT_EXCLUSION);
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_EXCLUSION);
+    filter.add_resolved_tag(tag, "sub.example.com");
+    EXPECT_EQ(filter.match_tag(tag).status, DFMS_DEFAULT);
+}
+
+TEST(MatchTest, FreeTunnelTomlRulesPrecedeGeoLists) {
+    DomainFilter filter;
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_GENERAL, "example.com @2:*.com"));
+    EXPECT_EQ(filter.match_domain("example.com"), DFMS_EXCLUSION);
+    EXPECT_EQ(filter.match_domain("other.com"), DFMS_DEFAULT);
+    ASSERT_TRUE(filter.update_exclusions(VPN_MODE_SELECTIVE, "example.com @3:*.com"));
+    EXPECT_EQ(filter.match_domain("example.com"), DFMS_EXCLUSION);
