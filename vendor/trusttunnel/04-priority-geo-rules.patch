+DomainFilterMatchStatus DomainFilter::policy_action(size_t tier) const {
+    const bool through_vpn = tier % 2 == 0;
+    const bool default_through_vpn = m_mode == VPN_MODE_GENERAL;
+    return through_vpn == default_through_vpn ? DFMS_DEFAULT : DFMS_EXCLUSION;
+}
