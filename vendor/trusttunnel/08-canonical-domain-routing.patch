@@ -12,6 +12,19 @@ namespace ag {
 static constexpr std::string_view WWW_PREFIX = "www.";
 static constexpr std::string_view WILDCARD_PREFIX = "*.";
 
+// DNS names are ASCII case-insensitive, including randomized query casing.
+// Normalize only the routing key: never rewrite the DNS packet or log label.
+static std::string canonical_domain(std::string_view domain) {
+    if (domain.ends_with('.') && !domain.ends_with("..")) {
+        domain.remove_suffix(1);
+    }
+    std::string result(domain);
+    std::transform(result.begin(), result.end(), result.begin(), [](char c) {
+        return c >= 'A' && c <= 'Z' ? char(c + ('a' - 'A')) : c;
+    });
+    return result;
+}
+
 enum DomainFilter::MatchFlags : uint32_t {
     DFMM_EXACT,      // match the domain itself and www. + the domain
     DFMM_SUBDOMAINS, // match only subdomains and www. + the domain, but not the domain itself
