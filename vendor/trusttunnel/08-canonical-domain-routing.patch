+// Route decoded DNS names, not their wire casing. The wire query is preserved.
+using CanonicalDnsSample = std::tuple<VpnMode, const char *, const char *, bool>;
+class FreeTunnelCanonicalDns : public DnsRoutingBase, public testing::WithParamInterface<CanonicalDnsSample> {};
+
+TEST_P(FreeTunnelCanonicalDns, KeepsTheSelectedRoute) {
+    const auto [mode, rules, domain, through_vpn] = GetParam();
+    vpn.update_exclusions(mode, rules);
+    ASSERT_NO_FATAL_FAILURE(open_connection());
+    ASSERT_NO_FATAL_FAILURE(raise_dns_request(domain));
+    if (through_vpn) {
+        run_event_loop_once();
+        ASSERT_EQ(1, redirect_upstream->connections.size());
+        ASSERT_EQ(0, system_complete);
+    } else {
+        mock_system_dns_server->expect({
+                .request = MockDnsServer::Request{.tcp = false, .qtype = 1, .qname = AG_FMT("{}.", domain)},
+        });
+        vpn_event_loop_exit(ev_loop.get(), DEFAULT_TIMEOUT);
+        vpn_event_loop_run(ev_loop.get());
+        ASSERT_EQ(1, system_complete);
+        ASSERT_EQ(0, redirect_upstream->connections.size());
+    }
+    ASSERT_EQ(0, system_unexpected);
+    ASSERT_EQ(0, bypass_upstream->connections.size());
+}
+
+INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelCanonicalDns,
+        testing::Values(CanonicalDnsSample{VPN_MODE_GENERAL, "bypass.example", "ByPaSs.ExAmPlE", false},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "selected.example", "SeLeCtEd.ExAmPlE", true},
+                CanonicalDnsSample{VPN_MODE_GENERAL, "ByPaSs.Example.", "bypass.example", false},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "Selected.Example.", "selected.example", true},
+                CanonicalDnsSample{VPN_MODE_GENERAL, "*.example", "SuB.ExAmPlE", false},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "*.example", "SuB.ExAmPlE", true},
+                CanonicalDnsSample{VPN_MODE_GENERAL, "@1:direct.example @2:*.example", "DiReCt.ExAmPlE", false},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "@1:direct.example @2:*.example", "DiReCt.ExAmPlE", false},
+                CanonicalDnsSample{VPN_MODE_GENERAL, "@0:vpn.example @3:*.example", "VpN.ExAmPlE", true},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "@0:vpn.example @3:*.example", "VpN.ExAmPlE", true},
+                CanonicalDnsSample{VPN_MODE_GENERAL, "bypass.example", "OtHeR.ExAmPlE", true},
+                CanonicalDnsSample{VPN_MODE_SELECTIVE, "selected.example", "OtHeR.ExAmPlE", false}));
+
+TEST_F(DnsRoutingBase, FreeTunnelDnsRejectionIsNotOverridden) {
+    ASSERT_NO_FATAL_FAILURE(raise_client_connection(client_id));
+    const auto action = vpn.tunnel->finalize_connect_action({.id = client_id, .action = VPN_CA_REJECT});
+    ASSERT_EQ(action, VPN_CA_REJECT);
+    vpn.tunnel->complete_connect_request(client_id, action);
+    run_event_loop_once();
+    ASSERT_EQ(client_listener->connections.at(client_id).result, CCR_REJECT);
+    ASSERT_FALSE(client_listener->connections.at(client_id).read_enabled);
+    ASSERT_EQ(0, redirect_upstream->connections.size());
+    ASSERT_EQ(0, bypass_upstream->connections.size());
+    ASSERT_EQ(0, system_complete);
+}
+
+TEST_F(DnsRoutingBase, FreeTunnelEncryptedDnsAndOtherTrafficKeepApplicationRoutes) {
+    for (uint16_t port : {uint16_t{443}, uint16_t{853}, uint16_t{22}}) {
+        for (int proto : {IPPROTO_TCP, IPPROTO_UDP}) {
+            for (auto forced : {VPN_CA_FORCE_BYPASS, VPN_CA_FORCE_REDIRECT, VPN_CA_REJECT}) {
+                const uint64_t id = vpn.listener_conn_id_generator.get();
+                const TunnelAddress destination = SocketAddress("2.2.2.2", port);
+                ClientConnectRequest event = {id, proto, &src, &destination};
+                vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+                EXPECT_EQ(vpn.tunnel->finalize_connect_action({.id = id, .action = forced}), forced);
+            }
+        }
+    }
+}
+
+TEST_F(DnsRoutingBase, FreeTunnelSharedResolverRoutesEachQuery) {
+    vpn.update_exclusions(VPN_MODE_GENERAL, "*.bypass.example");
+    ASSERT_NO_FATAL_FAILURE(open_connection());
+    for (const char *name : {"one.bypass.example", "TWO.ByPaSs.ExAmPlE"}) {
+        mock_system_dns_server->expect({
+                .request = MockDnsServer::Request{.tcp = false, .qtype = 1, .qname = AG_FMT("{}.", name)},
+        });
+        ASSERT_NO_FATAL_FAILURE(raise_dns_request(name));
+        vpn_event_loop_exit(ev_loop.get(), DEFAULT_TIMEOUT);
+        vpn_event_loop_run(ev_loop.get());
+        ASSERT_EQ(0, redirect_upstream->connections.size());
+    }
+    ASSERT_EQ(2, system_complete);
+    ASSERT_EQ(0, system_unexpected);
+    // The same socket's next query needs the VPN; it must not inherit bypass.
+    ASSERT_NO_FATAL_FAILURE(raise_dns_request("vpn.example"));
+    run_event_loop_once();
+    ASSERT_EQ(1, redirect_upstream->connections.size());
+    ASSERT_EQ(0, bypass_upstream->connections.size());
+}
+
+TEST_F(DnsRoutingBase, FreeTunnelTcpAndUdpDnsBothUseDomainPolicy) {
+    for (int proto : {IPPROTO_TCP, IPPROTO_UDP}) {
+        for (auto requested : {VPN_CA_DEFAULT, VPN_CA_FORCE_BYPASS, VPN_CA_FORCE_REDIRECT, VPN_CA_REJECT}) {
+            const uint64_t id = vpn.listener_conn_id_generator.get();
+            ClientConnectRequest event = {id, proto, &src, &dst};
+            vpn.tunnel->listener_handler(client_listener, CLIENT_EVENT_CONNECT_REQUEST, &event);
+            const auto expected = requested == VPN_CA_REJECT ? VPN_CA_REJECT : VPN_CA_DEFAULT;
+            EXPECT_EQ(vpn.tunnel->finalize_connect_action({.id = id, .action = requested}), expected);
+        }
+    }
+}
