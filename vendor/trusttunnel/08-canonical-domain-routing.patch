+TEST(MatchTest, FreeTunnelCanonicalNamesKeepPolicyPriority) {
+    for (VpnMode mode : {VPN_MODE_GENERAL, VPN_MODE_SELECTIVE}) {
+        DomainFilter filter;
+        ASSERT_TRUE(filter.update_exclusions(
+                mode, "@0:VPN.Example.COM. @1:DIRECT.Example.NET. @2:*.example.net @3:*.example.com"));
+        const auto tunnel = mode == VPN_MODE_GENERAL ? DFMS_DEFAULT : DFMS_EXCLUSION;
+        const auto direct = mode == VPN_MODE_GENERAL ? DFMS_EXCLUSION : DFMS_DEFAULT;
+        EXPECT_EQ(filter.match_domain("VpN.ExAmPlE.CoM"), tunnel);
+        EXPECT_EQ(filter.match_domain("DiReCt.ExAmPlE.NeT."), direct);
+        EXPECT_EQ(filter.match_domain("OtHeR.ExAmPlE.CoM"), direct);
+        EXPECT_EQ(filter.match_domain("OtHeR.ExAmPlE.NeT"), tunnel);
+        EXPECT_EQ(filter.match_domain("DiReCt.ExAmPlE.NeT.."), DFMS_DEFAULT);
+        EXPECT_EQ(filter.match_domain("VpN.ExAmPlE.CoM.."), DFMS_DEFAULT);
+    }
