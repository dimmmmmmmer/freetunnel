diff --git a/core/test/test_routing_generation.cpp b/core/test/test_routing_generation.cpp
new file mode 100644
index 0000000..1ba3ae0
--- /dev/null
+++ b/core/test/test_routing_generation.cpp
@@ -0,0 +1,72 @@
+#include "vpn_manager.h"
+#include <future>
+#include <gtest/gtest.h>
+
+using namespace ag; // NOLINT(google-build-using-namespace)
+
+class FreeTunnelRoutingGeneration : public testing::Test {
+protected:
+    Vpn *vpn = nullptr;
+
+    void SetUp() override {
+        VpnSettings settings{};
+        settings.handler = {[](void *, VpnEvent, void *) {}, nullptr};
+        settings.routing_generation = 10;
+        vpn = vpn_open(&settings);
+        ASSERT_NE(nullptr, vpn);
+        ASSERT_TRUE(vpn->run_event_loop());
+    }
+    void TearDown() override {
+        if (vpn != nullptr) {
+            vpn_stop(vpn);
+            vpn_close(vpn);
+        }
+    }
+    void on_core(std::function<void()> action) {
+        auto done = std::make_shared<std::promise<void>>();
+        auto future = done->get_future();
+        vpn->submit([action = std::move(action), done]() {
+            action();
+            done->set_value();
+        });
+        ASSERT_EQ(std::future_status::ready, future.wait_for(Secs{5}));
+    }
+    void burst(bool restore_original) {
+        auto entered = std::make_shared<std::promise<void>>();
+        auto ready = entered->get_future();
+        auto release = std::make_shared<std::promise<void>>();
+        auto proceed = release->get_future().share();
+        vpn->submit([entered, proceed]() {
+            entered->set_value();
+            EXPECT_EQ(std::future_status::ready, proceed.wait_for(Secs{5}));
+        });
+        ASSERT_EQ(std::future_status::ready, ready.wait_for(Secs{5}));
+        std::string rules = "vpn.example";
+        VpnStr exclusions{rules.data(), uint32_t(rules.size())};
+        vpn_update_routing(vpn, VPN_MODE_SELECTIVE, exclusions, 11);
+        // This app-only edit replaces a pending mode/domain edit in the native
+        // task slot. It must still carry and apply that edit's full snapshot.
+        vpn_update_routing(vpn, VPN_MODE_SELECTIVE, exclusions, 12);
+        if (restore_original) {
+            vpn_update_routing(vpn, VPN_MODE_GENERAL, {"", 0}, 13);
+        }
+        release->set_value();
+        on_core([this, restore_original]() {
+            EXPECT_EQ(restore_original ? 13 : 12, vpn->client.routing_generation);
+            EXPECT_EQ(restore_original ? VPN_MODE_GENERAL : VPN_MODE_SELECTIVE, vpn->client.exclusions_mode);
+            EXPECT_EQ(restore_original ? "" : "vpn.example", vpn->client.routing_exclusions);
+        });
+    }
+};
+
+TEST_F(FreeTunnelRoutingGeneration, InitialSnapshotVersionReachesTheCore) {
+    on_core([this]() {
+        EXPECT_EQ(10, vpn->client.routing_generation);
+    });
+}
+TEST_F(FreeTunnelRoutingGeneration, AppOnlyEditCannotCancelPendingDomainAndModeEdit) {
+    burst(false);
+}
+TEST_F(FreeTunnelRoutingGeneration, BurstReturningToInitialPolicyStillAdvancesVersion) {
+    burst(true);
+}
