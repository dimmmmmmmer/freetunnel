+        ag::DeclPtr<EC_KEY, &EC_KEY_free> ec{EC_KEY_new_by_curve_name(NID_X9_62_prime256v1)};
+        ASSERT_NE(ec, nullptr);
+        ASSERT_EQ(1, EC_KEY_generate_key(ec.get()));
+        ag::DeclPtr<EVP_PKEY, &EVP_PKEY_free> key{EVP_PKEY_new()};
+        ASSERT_NE(key, nullptr);
+        ASSERT_EQ(1, EVP_PKEY_set1_EC_KEY(key.get(), ec.get()));
+        ag::DeclPtr<X509, &X509_free> cert{X509_new()};
+        ASSERT_NE(cert, nullptr);
+        ASSERT_EQ(1, X509_set_version(cert.get(), 2));
+        ASSERT_EQ(1, ASN1_INTEGER_set(X509_get_serialNumber(cert.get()), 1));
+        ASSERT_NE(X509_gmtime_adj(X509_get_notBefore(cert.get()), -60), nullptr);
+        ASSERT_NE(X509_gmtime_adj(X509_get_notAfter(cert.get()), 3600), nullptr);
+        ASSERT_EQ(1, X509_set_pubkey(cert.get(), key.get()));
+        auto *name = X509_get_subject_name(cert.get());
+        ASSERT_EQ(1,
+                X509_NAME_add_entry_by_txt(
+                        name, "CN", MBSTRING_ASC, reinterpret_cast<const uint8_t *>("same-server.invalid"), -1, -1, 0));
+        ASSERT_EQ(1, X509_set_issuer_name(cert.get(), name));
+        ASSERT_GT(X509_sign(cert.get(), key.get(), EVP_sha256()), 0);
+        ASSERT_EQ(1, SSL_CTX_use_certificate(server_context.get(), cert.get()));
+        ASSERT_EQ(1, SSL_CTX_use_PrivateKey(server_context.get(), key.get()));
+    }
+
+    ag::SslPtr client(Policy &policy, ag::TlsSessionCacheScope scope) {
+        constexpr uint8_t alpn[] = {2, 'h', '2'};
+        auto result = ag::make_ssl(
+                verify_policy, &policy, {alpn, sizeof(alpn)}, "same-server.invalid", ag::MSPT_TLS, {}, {}, {}, scope);
+        if (!std::holds_alternative<ag::SslPtr>(result)) {
+            ADD_FAILURE() << std::get<std::string>(result);
+            return nullptr;
+        }
+        auto ssl = std::move(std::get<ag::SslPtr>(result));
+        EXPECT_EQ(1, SSL_set_min_proto_version(ssl.get(), GetParam()));
+        EXPECT_EQ(1, SSL_set_max_proto_version(ssl.get(), GetParam()));
+        return ssl;
+    }
+
+    bool handshake(SSL *client_ssl) {
+        if (client_ssl == nullptr) {
+            return false;
+        }
+        ag::SslPtr server{SSL_new(server_context.get())};
+        if (!server) {
+            return false;
+        }
+        SSL_set_accept_state(server.get());
+        BIO *client_bio = nullptr;
+        BIO *server_bio = nullptr;
+        if (BIO_new_bio_pair(&client_bio, 0, &server_bio, 0) != 1) {
+            return false;
+        }
+        SSL_set_bio(client_ssl, client_bio, client_bio);
+        SSL_set_bio(server.get(), server_bio, server_bio);
+        for (int i = 0; i < 100; ++i) {
+            int client_result = SSL_do_handshake(client_ssl);
+            int client_error = SSL_get_error(client_ssl, client_result);
+            int server_result = SSL_do_handshake(server.get());
+            int server_error = SSL_get_error(server.get(), server_result);
+            if (client_result == 1 && server_result == 1) {
+                // Consume TLS 1.3 post-handshake tickets as a real connection would.
+                char byte = 0;
+                EXPECT_EQ(1, SSL_write(server.get(), "x", 1));
+                EXPECT_EQ(1, SSL_read(client_ssl, &byte, 1));
+                EXPECT_EQ('x', byte);
+                return true;
+            }
+            if ((client_result != 1 && client_error != SSL_ERROR_WANT_READ && client_error != SSL_ERROR_WANT_WRITE)
+                    || (server_result != 1 && server_error != SSL_ERROR_WANT_READ
+                            && server_error != SSL_ERROR_WANT_WRITE)) {
+                return false;
+            }
+        }
+        ADD_FAILURE() << "Memory-BIO TLS handshake did not finish";
+        return false;
+    }
+};
+
+TEST_P(TlsSessionScope, RecoveryCanResumeWithinTheSamePolicy) {
+    auto scope = ag::make_tls_session_cache_scope();
+    Policy policy{true};
+    auto first = client(policy, scope);
+    ASSERT_TRUE(handshake(first.get()));
+    EXPECT_EQ(1, policy.calls);
+    EXPECT_FALSE(SSL_session_reused(first.get()));
+    auto resumed = client(policy, scope);
+    ASSERT_TRUE(handshake(resumed.get()));
+    EXPECT_TRUE(SSL_session_reused(resumed.get()));
+    EXPECT_EQ(1, policy.calls);
+}
+
+TEST_P(TlsSessionScope, ReplacingPolicyForTheSameHostRequiresVerification) {
+    Policy allow{true};
+    auto first = client(allow, ag::make_tls_session_cache_scope());
+    ASSERT_TRUE(handshake(first.get()));
+    Policy reject{false};
+    auto replacement = client(reject, ag::make_tls_session_cache_scope());
+    EXPECT_FALSE(handshake(replacement.get()));
+    EXPECT_FALSE(SSL_session_reused(replacement.get()));
+    EXPECT_EQ(1, reject.calls);
+}
+
+TEST_P(TlsSessionScope, LateOldHandshakeCannotPopulateTheNewPolicyCache) {
+    Policy allow{true};
+    auto old = client(allow, ag::make_tls_session_cache_scope());
+    auto new_scope = ag::make_tls_session_cache_scope();
+    Policy reject{false};
+    auto prepared = client(reject, new_scope);
+    ASSERT_NE(prepared, nullptr);
+    ASSERT_TRUE(handshake(old.get()));
+    auto replacement = client(reject, new_scope);
+    EXPECT_FALSE(handshake(replacement.get()));
+    EXPECT_FALSE(SSL_session_reused(replacement.get()));
+    EXPECT_EQ(1, reject.calls);
+}
+
+TEST_P(TlsSessionScope, MissingPolicyScopeDisablesCaching) {
+    Policy allow{true};
+    auto first = client(allow, {});
+    ASSERT_TRUE(handshake(first.get()));
+    Policy reject{false};
+    auto second = client(reject, {});
+    EXPECT_FALSE(handshake(second.get()));
+    EXPECT_FALSE(SSL_session_reused(second.get()));
+    EXPECT_EQ(1, reject.calls);
+}
+
+TEST_P(TlsSessionScope, DifferentRemoteIdCannotReuseTheSameHostSession) {
+    auto scope = ag::make_tls_session_cache_scope();
+    ag::VpnEndpoint endpoint{};
+    endpoint.address = *ag::SocketAddress("192.0.2.1", 443).c_storage();
+    endpoint.remote_id = "first.invalid";
+    Policy allow{true};
+    auto first = client(allow, ag::tls_session_cache_scope_for_endpoint(scope, endpoint));
+    ASSERT_TRUE(handshake(first.get()));
+    endpoint.remote_id = "second.invalid";
+    Policy reject{false};
+    auto second = client(reject, ag::tls_session_cache_scope_for_endpoint(scope, endpoint));
+    EXPECT_FALSE(handshake(second.get()));
+    EXPECT_EQ(1, reject.calls);
+}
+
+TEST_P(TlsSessionScope, DifferentEndpointAddressCannotReuseTheSameHostSession) {
+    auto scope = ag::make_tls_session_cache_scope();
+    ag::VpnEndpoint endpoint{};
+    endpoint.address = *ag::SocketAddress("192.0.2.1", 443).c_storage();
+    Policy allow{true};
+    auto first = client(allow, ag::tls_session_cache_scope_for_endpoint(scope, endpoint));
+    ASSERT_TRUE(handshake(first.get()));
+    endpoint.address = *ag::SocketAddress("192.0.2.2", 443).c_storage();
+    Policy reject{false};
+    auto second = client(reject, ag::tls_session_cache_scope_for_endpoint(scope, endpoint));
+    EXPECT_FALSE(handshake(second.get()));
+    EXPECT_EQ(1, reject.calls);
+}
