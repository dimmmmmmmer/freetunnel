+// Endpoint recovery must affect only flows that depend on that endpoint.
+// The direct stream/datagram socket and its client-side connection stay alive.
+class FreeTunnelDirectRecovery : public TunnelTest,
+                                 public testing::WithParamInterface<std::tuple<bool, bool, bool, bool>> {};
+
+TEST_P(FreeTunnelDirectRecovery, KeepsEstablishedDirectTrafficAcrossEndpointRecovery) {
+    const auto [ipv6, udp, selective, pending_direct] = GetParam();
+    vpn.kill_switch_on = true;
+    connection_protocol = udp ? IPPROTO_UDP : IPPROTO_TCP;
+    src = SocketAddress(ipv6 ? "[2001:db8::2]:42000" : "192.0.2.2:42000");
+    dst = SocketAddress(ipv6 ? "[2001:db8::1]:777" : "192.0.2.1:777");
+    vpn.exclusions_mode = selective ? VPN_MODE_SELECTIVE : VPN_MODE_GENERAL;
+    ASSERT_TRUE(vpn.domain_filter.update_exclusions(selective ? VPN_MODE_SELECTIVE : VPN_MODE_GENERAL,
+            selective ? "198.51.100.1 2001:db8:1::1" : "192.0.2.1 2001:db8::1"));
+    uint64_t direct_id = vpn.listener_conn_id_generator.get();
+    ASSERT_NO_FATAL_FAILURE(raise_client_connection(direct_id));
+    auto action = tun.finalize_connect_action({direct_id, VPN_CA_DEFAULT, "server", -1});
+    tun.complete_connect_request(direct_id, action);
+    ASSERT_EQ(1, bypass_upstream->connections.size());
+    uint64_t direct_server_id = bypass_upstream->connections.back();
+    if (!pending_direct) {
+        tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &direct_server_id);
+        tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &direct_id);
+    }
+
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        dst = SocketAddress(ipv6 ? "[2001:db8:1::1]:777" : "198.51.100.1:777");
+        uint64_t vpn_id = vpn.listener_conn_id_generator.get();
+        ASSERT_NO_FATAL_FAILURE(raise_client_connection(vpn_id));
+        action = tun.finalize_connect_action({vpn_id, VPN_CA_DEFAULT, "server", -1});
+        tun.complete_connect_request(vpn_id, action);
+        ASSERT_EQ(1, redirect_upstream->connections.size());
+        uint64_t vpn_server_id = redirect_upstream->connections.back();
+        tun.upstream_handler(redirect_upstream, SERVER_EVENT_CONNECTION_OPENED, &vpn_server_id);
+        tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &vpn_id);
+
+        tun.on_before_endpoint_disconnect(redirect_upstream.get());
+        tun.upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_CLOSED, nullptr);
+        tun.on_after_endpoint_disconnect(redirect_upstream.get());
+        ASSERT_FALSE(tun.endpoint_upstream_connected);
+        if (pending_direct && attempt == 0) {
+            // A direct connect completing while the endpoint is down is valid too.
+            tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &direct_server_id);
+            ASSERT_EQ(client_listener->connections.at(direct_id).result, CCR_PASS);
+            tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &direct_id);
+        }
+        ASSERT_EQ(1, client_listener->connections.count(direct_id));
+        ASSERT_EQ(0, client_listener->connections.count(vpn_id));
+        ASSERT_EQ(std::vector<uint64_t>{direct_server_id}, bypass_upstream->connections);
+        ASSERT_TRUE(redirect_upstream->connections.empty());
+
+        const uint8_t payload[] = {'d', 'i', 'r', 'e', 'c', 't'};
+        ClientRead upload{direct_id, payload, sizeof(payload), 0};
+        tun.listener_handler(client_listener, CLIENT_EVENT_READ, &upload);
+        EXPECT_EQ(sizeof(payload), upload.result);
+        EXPECT_EQ(sizeof(payload), bypass_upstream->last_send);
+        const size_t received = client_listener->received_bytes;
+        ServerReadEvent download{direct_server_id, payload, sizeof(payload), 0};
+        tun.upstream_handler(bypass_upstream, SERVER_EVENT_READ, &download);
+        EXPECT_EQ(received + sizeof(payload), client_listener->received_bytes);
+        EXPECT_TRUE(redirect_upstream->connections.empty());
+
+        tun.upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_OPENED, nullptr);
+        EXPECT_EQ(1, client_listener->connections.count(direct_id));
+    }
+    // Explicit disconnect/teardown must still close the surviving direct flow.
+    tun.reset_connections(client_listener.get());
+    EXPECT_TRUE(client_listener->connections.empty());
+    EXPECT_TRUE(bypass_upstream->connections.empty());
+}
+
+INSTANTIATE_TEST_SUITE_P(FreeTunnel, FreeTunnelDirectRecovery,
+        testing::Combine(testing::Bool(), testing::Bool(), testing::Bool(), testing::Bool()));
