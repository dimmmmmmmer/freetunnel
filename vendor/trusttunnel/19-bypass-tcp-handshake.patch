+class LimitedIpv6Test : public TunnelTest {
+protected:
+    uint32_t previous_interface = 0;
+    void SetUp() override {
+        TunnelTest::SetUp();
+        previous_interface = vpn_network_manager_get_outbound_interface();
+        vpn_network_manager_set_outbound_interface(42);
+        vpn_network_manager_set_limited_ipv6_interface(42);
+        ASSERT_TRUE(vpn.domain_filter.update_exclusions(VPN_MODE_SELECTIVE, "*.example"));
+    }
+    void TearDown() override {
+        vpn_network_manager_set_limited_ipv6_interface(0);
+        vpn_network_manager_set_outbound_interface(previous_interface);
+        TunnelTest::TearDown();
+    }
+    uint64_t request(const char *address) {
+        uint64_t id = vpn.listener_conn_id_generator.get();
+        dst = SocketAddress(address);
+        raise_client_connection(id);
+        tun.complete_connect_request(id, tun.finalize_connect_action({id, VPN_CA_DEFAULT, "app", 1}));
+        run_event_loop_once();
+        return id;
+    }
+};
+
+TEST_F(LimitedIpv6Test, DualStackClientCanRaceWhileIpv6OnlyStillCompletes) {
+    auto v6 = request("[2001:db8::1]:443");
+    auto v4 = request("192.0.2.1:443");
+    EXPECT_FALSE(client_listener->connections[v6].result);
+    EXPECT_EQ(client_listener->connections[v4].result, CCR_PASS);
+    EXPECT_TRUE(bypass_upstream->connections.empty());
+    EXPECT_TRUE(redirect_upstream->connections.empty());
+
+    vpn_event_loop_exit(ev_loop.get(), Millis{850});
+    vpn_event_loop_run(ev_loop.get());
+    EXPECT_EQ(client_listener->connections[v6].result, CCR_PASS);
+}
+
+TEST_F(LimitedIpv6Test, KnownRoutesWaitForTheirPeer) {
+    dst = SocketAddress("[2001:db8::1]:443");
+    for (bool direct : {true, false}) {
+        auto id = vpn.listener_conn_id_generator.get();
+        ASSERT_NO_FATAL_FAILURE(raise_client_connection(id));
+        auto action = direct ? VPN_CA_FORCE_BYPASS : VPN_CA_FORCE_REDIRECT;
+        tun.complete_connect_request(id, tun.finalize_connect_action({id, action, "app", 1}));
+        run_event_loop_once();
+        EXPECT_FALSE(client_listener->connections[id].result);
+        auto upstream = direct ? bypass_upstream : redirect_upstream;
+        ASSERT_FALSE(upstream->connections.empty());
+        auto peer = upstream->connections.back();
+        tun.upstream_handler(upstream, SERVER_EVENT_CONNECTION_OPENED, &peer);
+        EXPECT_EQ(client_listener->connections[id].result, CCR_PASS);
+    }
+}
+
+TEST_F(LimitedIpv6Test, ClientCanCancelWhileWaiting) {
+    auto id = request("[2001:db8::1]:443");
+    ASSERT_FALSE(client_listener->connections[id].result);
+    client_listener->close_connection(id, false, false);
+    vpn_event_loop_exit(ev_loop.get(), Millis{850});
+    vpn_event_loop_run(ev_loop.get());
+    EXPECT_FALSE(client_listener->connections.contains(id));
+    EXPECT_TRUE(bypass_upstream->connections.empty());
+}
+
+TEST_F(LimitedIpv6Test, LocalAddressesUdpAndNewUplinkKeepNormalTiming) {
+    auto local = request("[fd00::1]:443");
+    EXPECT_EQ(client_listener->connections[local].result, CCR_PASS);
+    connection_protocol = IPPROTO_UDP;
+    auto udp = request("[2001:db8::2]:443");
+    EXPECT_EQ(client_listener->connections[udp].result, CCR_PASS);
+    connection_protocol = IPPROTO_TCP;
+    vpn_network_manager_set_outbound_interface(43);
+    auto healthy = request("[2001:db8::3]:443");
+    EXPECT_EQ(client_listener->connections[healthy].result, CCR_PASS);
+}
