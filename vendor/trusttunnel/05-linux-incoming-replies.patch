+// Local replies to connections initiated outside the tunnel must keep their
+// original sockets. Proxying them creates a different UDP source port and
+// cannot reproduce an accepted TCP connection. Reserve one packet-mark bit;
+// do not overwrite other firewall marks or use a source-port allowlist.
+static constexpr std::string_view REPLY_MARK = "0x00800000/0x00800000";
+static constexpr std::string_view REPLY_RULESET = R"nft(
+add table inet freetunnel_reply
+add chain inet freetunnel_reply output { type route hook output priority mangle; policy accept; }
+add rule inet freetunnel_reply output meta l4proto { tcp, udp } ct direction reply counter meta mark set meta mark | 0x00800000
+)nft";
 static constexpr std::string_view PRIVILEGED_PORTS = "1-1024";
 static constexpr std::string_view VNC_PORTS = "5900-5920";
 
