+#include <gtest/gtest.h>
+
+#include "vpn/trusttunnel/client.h"
+
+using namespace ag;
+
+static TrustTunnelConfig make_config() {
+    TrustTunnelConfig config;
+    config.listener = TrustTunnelConfig::TunListener{.mtu_size = 1280};
+    config.endpoint_sockets_protected = true;
+    config.killswitch_enabled = true;
+    config.location.username = "test-user";
+    config.location.password = "test-password";
+    config.location.endpoints.push_back({"test.invalid", "127.0.0.1:9", ""});
+    return config;
+}
+
+static VpnCallbacks make_callbacks() {
+    return {
+            .protect_handler =
+                    [](SocketProtectEvent *event) {
+                        event->result = 0;
+                    },
+            .verify_handler =
+                    [](VpnVerifyCertificateEvent *event) {
+                        event->result = -1;
+                    },
+            .state_changed_handler = [](VpnStateChangedEvent *) {},
+            .client_output_handler = [](VpnClientOutputEvent *) {},
+    };
+}
+
+TEST(EndpointPreparation, RejectConflictingSniBeforeTouchingClient) {
+    auto config = make_config();
+    config.location.endpoints[0].hostname = "test.invalid|remote.invalid";
+    config.location.endpoints[0].custom_sni = "custom.invalid";
+    EXPECT_TRUE(TrustTunnelClient::prepare_endpoint(std::move(config)).has_error());
+}
+
+TEST(EndpointPreparation, RejectInvalidDnsBeforeTouchingClient) {
+    auto config = make_config();
+    config.location.dns_upstreams = std::vector<std::string>{"invalid-scheme://dns.invalid"};
+    EXPECT_TRUE(TrustTunnelClient::prepare_endpoint(std::move(config)).has_error());
+}
+
+TEST(EndpointPreparation, RejectEmptyEndpoints) {
+    auto config = make_config();
+    config.location.endpoints.clear();
+    EXPECT_TRUE(TrustTunnelClient::prepare_endpoint(std::move(config)).has_error());
+}
+
+TEST(EndpointPreparation, PreparedResultDoesNotStartStoppedClient) {
+    TrustTunnelClient client(make_config(), make_callbacks());
+    auto prepared = TrustTunnelClient::prepare_endpoint(make_config());
+    ASSERT_FALSE(prepared.has_error());
+    EXPECT_TRUE(client.replace_endpoint(prepared.value()));
+    client.disconnect();
+}
+
+struct EndpointReplacementTest : testing::Test {
+    std::unique_ptr<TrustTunnelClient> client;
+
+    void SetUp() override {
+        client = std::make_unique<TrustTunnelClient>(make_config(), make_callbacks());
+        auto error = client->connect(TrustTunnelClient::UseProcessPackets{});
+        ASSERT_FALSE(error) << (error ? error->str() : "");
+    }
+
+    void TearDown() override {
+        if (client) {
+            client->disconnect();
+        }
+    }
+
+    bool replace(TrustTunnelConfig config) {
+        auto prepared = TrustTunnelClient::prepare_endpoint(std::move(config));
+        EXPECT_FALSE(prepared.has_error());
+        if (prepared.has_error()) {
+            return false;
+        }
+        return !client->replace_endpoint(prepared.value());
+    }
+};
+
+TEST_F(EndpointReplacementTest, RepeatedSwitchAndSingleUsePreparedResult) {
+    for (int i = 0; i < 3; ++i) {
+        auto config = make_config();
+        config.location.password = "replacement-password";
+        config.location.skip_verification = true;
+        auto prepared = TrustTunnelClient::prepare_endpoint(std::move(config));
+        ASSERT_FALSE(prepared.has_error());
+        EXPECT_FALSE(client->replace_endpoint(prepared.value()));
+        EXPECT_TRUE(client->replace_endpoint(prepared.value()));
+    }
+}
+
+TEST_F(EndpointReplacementTest, RejectListenerAndKillSwitchChangesThenAllowValidSwitch) {
+    auto config = make_config();
+    std::get<TrustTunnelConfig::TunListener>(config.listener).mtu_size = 1400;
+    EXPECT_FALSE(replace(std::move(config)));
+    config = make_config();
+    config.killswitch_enabled = false;
+    EXPECT_FALSE(replace(std::move(config)));
+    config = make_config();
+    config.killswitch_allow_ports = "443";
+    EXPECT_FALSE(replace(std::move(config)));
+    EXPECT_TRUE(replace(make_config()));
+}
+
+TEST_F(EndpointReplacementTest, ReplacementAfterDisconnectDoesNotRestart) {
+    auto prepared = TrustTunnelClient::prepare_endpoint(make_config());
+    ASSERT_FALSE(prepared.has_error());
+    client->disconnect();
+    EXPECT_TRUE(client->replace_endpoint(prepared.value()));
+}
