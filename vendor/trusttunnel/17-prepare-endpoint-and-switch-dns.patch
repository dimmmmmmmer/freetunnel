+    const std::string domains = "direct.example";
+    VpnRoutingConfig routing{VPN_MODE_GENERAL, {domains.data(), static_cast<uint32_t>(domains.size())}, 17};
+    struct Context {
+        Vpn *vpn;
+        bool committed = false;
+    } context{vpn};
+    auto commit = [](void *arg) {
+        auto *ctx = static_cast<Context *>(arg);
+        ctx->committed = ctx->vpn->client.routing_generation == 17;
+    };
+    VpnError result{};
+    std::thread caller([&] {
+        const auto deadline = SteadyClock::now() + Secs{2};
+        while (!vpn_event_loop_is_active(vpn->ev_loop.get()) && SteadyClock::now() < deadline)
+            std::this_thread::yield();
+        result = vpn_replace_endpoint(vpn, &replacement, commit, &context, nullptr, &routing);
+    });
+    const bool reached = await_state_change(VPN_SS_RECOVERING);
+    caller.join();
+    ASSERT_TRUE(reached);
+    EXPECT_EQ(result.code, VPN_EC_NOERROR);
