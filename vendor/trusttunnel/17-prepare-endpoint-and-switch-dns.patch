+Error<TrustTunnelClient::ConnectResultError> TrustTunnelClient::replace_endpoint(
+        const std::shared_ptr<PreparedEndpoint> &prepared, const std::function<void()> &on_committed,
+        const EndpointRouting *routing) {
+    if (!prepared || prepared->consumed || m_vpn.load() == nullptr) {
+        return make_error(ConnectResultError{}, "No prepared endpoint or running session");
+    }
+    const auto &config = prepared->config;
+    if (!m_config.endpoint_sockets_protected || config.listener != m_config.listener
+            || config.killswitch_enabled != m_config.killswitch_enabled
+            || config.killswitch_allow_ports != m_config.killswitch_allow_ports
+            || config.post_quantum_group_enabled != m_config.post_quantum_group_enabled
+            || config.exclusions_tcp_early_ack_enabled != m_config.exclusions_tcp_early_ack_enabled
+            || config.exclusions_preresolve_enabled != m_config.exclusions_preresolve_enabled
+            || config.exclusions_preresolve_max_queries != m_config.exclusions_preresolve_max_queries
+            || config.exclusions_scannable_ports != m_config.exclusions_scannable_ports) {
+        return make_error(ConnectResultError{}, "Tunnel settings changed; disconnect before applying them");
+    }
+    const auto &effective_dns = config.location.dns_upstreams.value_or(config.legacy_dns_upstreams);
+    std::vector<const char *> upstreams;
+    for (const auto &upstream : effective_dns) {
+        upstreams.push_back(upstream.c_str());
+    }
+    VpnListenerConfig dns{.dns_upstreams = {upstreams.data(), uint32_t(upstreams.size())}};
+    struct Commit {
+        TrustTunnelClient *client;
+        PreparedEndpoint *prepared;
+        const std::function<void()> *on_committed;
+    } commit{this, prepared.get(), &on_committed};
+    VpnRoutingConfig policy{};
+    if (routing != nullptr) {
+        policy = {
+                routing->mode, {routing->exclusions.data(), uint32_t(routing->exclusions.size())}, routing->generation};
+    }
+    auto error = vpn_replace_endpoint(
+            m_vpn, &prepared->parameters.upstream_config,
+            [](void *arg) {
+                auto &context = *static_cast<Commit *>(arg);
+                context.client->m_config.location = std::move(context.prepared->config.location);
+                context.client->m_config.legacy_dns_upstreams =
+                        std::move(context.prepared->config.legacy_dns_upstreams);
+                context.prepared->consumed = true;
+                if (*context.on_committed) {
+                    (*context.on_committed)();
+                }
+            },
+            &commit, &dns, routing != nullptr ? &policy : nullptr);
+    if (error.code != 0) {
+        return make_error(ConnectResultError{}, safe_to_string_view(error.text));
+    }
     return {};
 }

