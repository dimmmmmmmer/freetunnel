+            .dns_upstreams = {old_dns, 1},
+            .dns_alt_exclusions_route = true,
+    };
+    vpn->client.listener_config = vpn_listener_config_clone(&old_listener);
+    VpnEndpoint endpoint{sockaddr_from_str("127.0.0.4:443"), "new-server"};
+    VpnUpstreamConfig replacement{
+            .location = {.id = "replacement", .endpoints = {&endpoint, 1}},
+            .username = "new-user",
+            .password = "new-password",
+    };
+    const char *new_dns[] = {"9.9.9.9:53", "tls://1.0.0.1"};
+    VpnListenerConfig dns{.dns_upstreams = {new_dns, 2}};
+    for (int round = 0; round < 2; ++round) {
+        if (round == 1) {
+            dns.dns_upstreams = {};
+        }
+        VpnError result{};
+        std::thread caller([&] {
+            const auto deadline = SteadyClock::now() + Secs{2};
+            while (!vpn_event_loop_is_active(vpn->ev_loop.get()) && SteadyClock::now() < deadline) {
+                std::this_thread::yield();
