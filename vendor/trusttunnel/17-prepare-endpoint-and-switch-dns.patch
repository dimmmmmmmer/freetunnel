+Result<std::shared_ptr<TrustTunnelClient::PreparedEndpoint>, TrustTunnelClient::ConnectResultError>
+TrustTunnelClient::prepare_endpoint(TrustTunnelConfig config) {
+    auto prepared = std::make_shared<PreparedEndpoint>();
+    prepared->config = std::move(config);
+    const auto &dns = prepared->config.location.dns_upstreams.value_or(prepared->config.legacy_dns_upstreams);
+    for (const auto &upstream : dns) {
+        if (upstream.empty() || vpn_validate_dns_upstream(upstream.c_str()) != VPN_DUVS_OK) {
+            return make_error(ConnectResultError{}, "Invalid DNS upstream");
+        }
+    }
+    if (auto error = prepare_upstream(prepared->config.location, *prepared)) {
+        return error;
+    }
+    return prepared;
+}
