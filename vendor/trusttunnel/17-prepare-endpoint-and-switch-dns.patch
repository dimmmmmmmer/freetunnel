+TEST_F(ConnectedVpnManagerTest, StaleRoutingReplacementKeepsOldEndpoint) {
+    VpnEndpoint endpoint{sockaddr_from_str("127.0.0.4:443"), "new-server"};
+    VpnUpstreamConfig replacement{
+            .location = {.id = "replacement", .endpoints = {&endpoint, 1}},
+            .username = "new-user",
+            .password = "new-password",
+    };
+    vpn->client.routing_generation = 18;
+    const std::string domains = "stale.example";
+    VpnRoutingConfig routing{VPN_MODE_GENERAL, {domains.data(), static_cast<uint32_t>(domains.size())}, 17};
+    const auto *old_config = vpn->upstream_config.get();
+    bool committed = false;
+    auto commit = [](void *arg) {
+        *static_cast<bool *>(arg) = true;
+    };
+    // The fixture owns a paused event loop: drive it until the transaction replies.
+    std::atomic<bool> done = false;
+    VpnError result{};
+    std::thread caller([&] {
+        const auto deadline = SteadyClock::now() + Secs{2};
+        while (!vpn_event_loop_is_active(vpn->ev_loop.get()) && SteadyClock::now() < deadline)
+            std::this_thread::yield();
+        result = vpn_replace_endpoint(vpn, &replacement, commit, &committed, nullptr, &routing);
+        done = true;
+    });
+    const auto deadline = SteadyClock::now() + Secs{3};
+    while (!done && SteadyClock::now() < deadline)
+        loop_once();
+    caller.join();
+    EXPECT_NE(result.code, VPN_EC_NOERROR);
+    EXPECT_FALSE(committed);
+    EXPECT_EQ(vpn->upstream_config.get(), old_config);
+    EXPECT_EQ(vpn->client.routing_generation, 18u);
+    EXPECT_EQ(vpn->fsm.get_state(), VPN_SS_CONNECTED);
+}
