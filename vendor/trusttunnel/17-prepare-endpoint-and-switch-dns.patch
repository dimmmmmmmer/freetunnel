+TEST_F(ConnectedVpnManagerTest, ReplacementChangesAndClearsDnsWithoutChangingListenerPolicy) {
+    const char *old_dns[] = {"1.1.1.1:53"};
+    VpnListenerConfig old_listener{
+            .timeout_ms = 4567,
+            .dns_upstreams = {old_dns, 1},
+            .dns_alt_exclusions_route = true,
+    };
+    vpn->client.listener_config = vpn_listener_config_clone(&old_listener);
+    VpnEndpoint endpoint{sockaddr_from_str("127.0.0.4:443"), "new-server"};
+    VpnUpstreamConfig replacement{
+            .location = {.id = "replacement", .endpoints = {&endpoint, 1}},
+            .username = "new-user",
+            .password = "new-password",
+    };
+    const char *new_dns[] = {"9.9.9.9:53", "tls://1.0.0.1"};
+    VpnListenerConfig dns{.dns_upstreams = {new_dns, 2}};
+    for (int round = 0; round < 2; ++round) {
+        if (round == 1) {
+            dns.dns_upstreams = {};
+        }
+        VpnError result{};
+        std::thread caller([&] {
+            const auto deadline = SteadyClock::now() + Secs{2};
+            while (!vpn_event_loop_is_active(vpn->ev_loop.get()) && SteadyClock::now() < deadline) {
+                std::this_thread::yield();
+            }
+            result = vpn_replace_endpoint(vpn, &replacement, nullptr, nullptr, &dns);
+        });
+        const bool reached = await_state_change(VPN_SS_RECOVERING);
+        caller.join();
+        ASSERT_TRUE(reached);
+        ASSERT_EQ(result.code, VPN_EC_NOERROR);
+        EXPECT_EQ(vpn->client.listener_config.timeout_ms, 4567u);
+        EXPECT_TRUE(vpn->client.listener_config.dns_alt_exclusions_route);
+        EXPECT_EQ(vpn->client.listener_config.dns_upstreams.size, round == 0 ? 2u : 0u);
+        if (round == 0) {
+            EXPECT_STREQ(vpn->client.listener_config.dns_upstreams.data[0], "9.9.9.9:53");
+            EXPECT_STREQ(vpn->client.listener_config.dns_upstreams.data[1], "tls://1.0.0.1");
+            EXPECT_NE(vpn->client.listener_config.dns_upstreams.data, new_dns);
+        }
+    }
+    // The mocked VpnClient deliberately does not own listener configuration.
+    vpn_listener_config_destroy(&vpn->client.listener_config);
+}
