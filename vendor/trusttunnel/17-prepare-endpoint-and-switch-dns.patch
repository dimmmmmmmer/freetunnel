+        });
+        const bool reached = await_state_change(VPN_SS_RECOVERING);
+        caller.join();
+        ASSERT_TRUE(reached);
+        ASSERT_EQ(result.code, VPN_EC_NOERROR);
+        EXPECT_EQ(vpn->client.listener_config.timeout_ms, 4567u);
+        EXPECT_TRUE(vpn->client.listener_config.dns_alt_exclusions_route);
+        EXPECT_EQ(vpn->client.listener_config.dns_upstreams.size, round == 0 ? 2u : 0u);
+        if (round == 0) {
+            EXPECT_STREQ(vpn->client.listener_config.dns_upstreams.data[0], "9.9.9.9:53");
+            EXPECT_STREQ(vpn->client.listener_config.dns_upstreams.data[1], "tls://1.0.0.1");
+            EXPECT_NE(vpn->client.listener_config.dns_upstreams.data, new_dns);
+        }
