+// Added by FreeTunnel, see the header.
+void TrustTunnelClient::update_exclusions(VpnMode mode, std::string_view exclusions) {
+    if (Vpn *vpn = m_vpn.load()) {
+        vpn_update_exclusions(vpn, mode, {exclusions.data(), (uint32_t) exclusions.size()});
+    }
+}
+
 bool TrustTunnelClient::process_client_packets(VpnPackets packets) {
     return m_vpn && vpn_process_client_packets(m_vpn, packets);
 }
