+class HostnameRoutingTest : public TunnelTest {
+protected:
+    uint64_t request(VpnMode mode, const char *rule, const char *address) {
+        vpn.exclusions_mode = mode;
+        EXPECT_TRUE(vpn.domain_filter.update_exclusions(mode, rule));
+        auto id = vpn.listener_conn_id_generator.get();
+        dst = SocketAddress(address);
+        raise_client_connection(id);
+        tun.complete_connect_request(id, tun.finalize_connect_action({id, VPN_CA_DEFAULT, "app", 1}));
+        run_event_loop_once();
+        return id;
+    }
+};
+
+TEST_F(HostnameRoutingTest, SilentClientTimesOutUnlessRouteIsAlreadyKnown) {
+    auto id = request(VPN_MODE_SELECTIVE, "*.example", "192.0.2.1:443");
+    ASSERT_EQ(client_listener->connections[id].result, CCR_PASS);
+    tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &id);
+    vpn_event_loop_exit(ev_loop.get(), Millis{10200});
+    vpn_event_loop_run(ev_loop.get());
+    EXPECT_TRUE(bypass_upstream->connections.empty());
+    EXPECT_TRUE(redirect_upstream->connections.empty());
+    EXPECT_FALSE(client_listener->connections.contains(id));
+    EXPECT_EQ(client_listener->received_bytes, 0u);
+
+    auto control = request(VPN_MODE_GENERAL, "192.0.2.1 localhost", "192.0.2.1:443");
+    ASSERT_EQ(bypass_upstream->connections.size(), 1u);
+    auto peer = bypass_upstream->connections.back();
+    tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &peer);
+    tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &control);
+    const uint8_t greeting[] = {'H', 'i', '\n'};
+    ServerReadEvent read{peer, greeting, sizeof(greeting), 0};
+    tun.upstream_handler(bypass_upstream, SERVER_EVENT_READ, &read);
+    EXPECT_EQ(client_listener->received_bytes, sizeof(greeting));
+}
+
+class HostnameRecoveryTest : public HostnameRoutingTest, public testing::WithParamInterface<bool> {};
+TEST_P(HostnameRecoveryTest, DirectTcpWhenEndpointGoesDown) {
+    auto id = request(VPN_MODE_GENERAL, "localhost", "192.0.2.1:443");
+    ASSERT_EQ(client_listener->connections[id].result, CCR_PASS);
+    tun.listener_handler(client_listener, CLIENT_EVENT_CONNECTION_ACCEPTED, &id);
+    ClientRead read{id, CLIENT_HELLO, sizeof(CLIENT_HELLO), 0}; // SNI localhost matches the bypass rule.
+    tun.listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+    ASSERT_EQ(bypass_upstream->connections.size(), 1u);
+    ASSERT_TRUE(redirect_upstream->connections.empty());
+    auto direct = bypass_upstream->connections.back();
+    if (GetParam()) {
+        tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &direct);
+    }
+    tun.on_before_endpoint_disconnect(redirect_upstream.get());
+    tun.upstream_handler(redirect_upstream, SERVER_EVENT_SESSION_CLOSED, nullptr);
+    tun.on_after_endpoint_disconnect(redirect_upstream.get());
+    run_event_loop_once();
+    ASSERT_TRUE(client_listener->connections.contains(id));
+    ASSERT_EQ(bypass_upstream->connections.size(), 1u);
+    if (!GetParam()) {
+        tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &direct);
+    }
+    run_event_loop_once();
+    EXPECT_TRUE(client_listener->connections[id].read_enabled);
+    // TCP listeners retain unconsumed bytes while reads are paused.
+    ASSERT_EQ(read.result, 0);
+    tun.listener_handler(client_listener, CLIENT_EVENT_READ, &read);
+    EXPECT_EQ(read.result, sizeof(CLIENT_HELLO));
+    EXPECT_EQ(bypass_upstream->total_sent, sizeof(CLIENT_HELLO));
+    EXPECT_TRUE(redirect_upstream->connections.empty());
+}
+INSTANTIATE_TEST_SUITE_P(Window, HostnameRecoveryTest, testing::Bool());
