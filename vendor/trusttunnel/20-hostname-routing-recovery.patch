+TEST_F(LimitedIpv6Test, GeneralModeAllowsIpv4ToRace) {
+    ASSERT_TRUE(vpn.domain_filter.update_exclusions(VPN_MODE_GENERAL, "localhost"));
+    auto v6 = request("[2001:db8::1]:443");
+    auto v4 = request("192.0.2.1:443");
+    EXPECT_FALSE(client_listener->connections[v6].result);
+    EXPECT_EQ(client_listener->connections[v4].result, CCR_PASS);
+}
+
+TEST_F(LimitedIpv6Test, ColdUplinkDelaysAckUntilDirectIpv6Succeeds) {
+    vpn_network_manager_set_limited_ipv6_interface(0);
+    vpn.direct_ipv6_confirmed_until = {};
+    auto cold = request("[2001:db8::1]:443");
+    EXPECT_FALSE(client_listener->connections[cold].result);
+
+    auto direct = vpn.listener_conn_id_generator.get();
+    raise_client_connection(direct);
+    tun.complete_connect_request(direct, VPN_CA_FORCE_BYPASS);
+    ASSERT_EQ(bypass_upstream->connections.size(), 1u);
+    auto peer = bypass_upstream->connections.back();
+    tun.upstream_handler(bypass_upstream, SERVER_EVENT_CONNECTION_OPENED, &peer);
+    auto confirmed = request("[2001:db8::2]:443");
+    EXPECT_EQ(client_listener->connections[confirmed].result, CCR_PASS);
+
+    tun.on_network_change();
+    auto changed = request("[2001:db8::3]:443");
+    EXPECT_FALSE(client_listener->connections[changed].result);
+    bypass_upstream->ip_version_availability.reset(IPV4);
+    auto ipv6_only = request("[2001:db8::4]:443");
+    EXPECT_EQ(client_listener->connections[ipv6_only].result, CCR_PASS);
+}
