    <string name="text_receive_failed">Couldn’t receive from a phone. Try again.</string>
    <string name="text_receive_timed_out">Nothing arrived in 5 minutes. Open Receive from phone again for a new code.</string>
    <string name="text_receive_locked_out">A wrong code was sent 3 times, so receiving stopped. If that wasn’t you, someone else on this network tried to send a configuration. Open Receive from phone again for a new code.</string>
