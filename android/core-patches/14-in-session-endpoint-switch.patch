+VpnError vpn_replace_endpoint(
+        Vpn *vpn, const VpnUpstreamConfig *config, void (*commit_certificate_policy)(void *), void *arg) {
+    if (vpn == nullptr || config == nullptr) {
+        return {VPN_EC_INVALID_SETTINGS, "VPN and endpoint configuration are required"};
+    }
+    std::unique_lock lock(vpn->stop_guard);
+    if (config->location.endpoints.size > 0 && config->location.endpoints.data == nullptr) {
+        return {VPN_EC_INVALID_SETTINGS, "Endpoint array is required"};
+    }
+    if (auto error = validate_upstream_config(vpn, config); error.code != VPN_EC_NOERROR) {
+        return error;
+    }
+    if (!vpn->executor_thread.joinable() || !vpn_event_loop_is_active(vpn->ev_loop.get())) {
+        return {VPN_EC_ERROR, "VPN client worker is not running"};
+    }
+    auto replacement = vpn_upstream_config_clone(config);
+    const bool committed = event_loop::dispatch_sync(vpn->ev_loop.get(), [&]() mutable {
+        // Stop all producers that refer to the old endpoint/config first.
+        // disconnect() retains the TUN listener and bypass upstream; vpn_stop()
+        // would destroy both and must not be used for a server change.
+        vpn->disconnect();
+        vpn->recovery = {};
+        vpn->postponement_window_timer.reset();
+        vpn->selected_endpoint.reset();
+        vpn->client.tcp_socket.reset();
+        vpn->client.quic_connector.reset();
+        vpn->pending_error.reset();
+        vpn->update_upstream_config(std::move(replacement));
+        if (commit_certificate_policy != nullptr) {
+            commit_certificate_policy(arg);
+        }
+        vpn->fsm.perform_transition(vpn_fsm::CE_REPLACE_ENDPOINT, nullptr);
+    });
+    return committed ? VpnError{} : VpnError{VPN_EC_EVENT_LOOP_FAILURE, "Endpoint replacement was cancelled"};
 }

