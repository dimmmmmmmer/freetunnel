+// Switch an endpoint through the public API while the hijacked loop is driven
+// by this fixture. The caller must be on another thread: the API commits its
+// change synchronously on the core thread, like vpn_listen().
+TEST_F(ConnectedVpnManagerTest, ReplaceEndpointKeepsSessionAndCommitsCertificatePolicyBeforePing) {
+    vpn->client.kill_switch_on = true;
+    vpn->client.tunnel = std::make_unique<Tunnel>();
+    VpnEventLoop *original_loop = vpn->ev_loop.get();
+    auto *original_network_manager = vpn->network_manager.get();
+    VpnEndpoint endpoint{sockaddr_from_str("127.0.0.4:443"), "new-server"};
+    VpnUpstreamConfig replacement{
+            .main_protocol = VPN_UP_HTTP2,
+            .location = {.id = "replacement", .endpoints = {&endpoint, 1}},
+            .username = "new-user",
+            .password = "new-password",
+    };
+    struct CommitContext {
+        Vpn *vpn;
+        bool called = false;
+        bool old_endpoint_stopped = false;
+    } context{vpn};
+    VpnError result{};
+    auto commit = [](void *arg) {
+        auto *ctx = static_cast<CommitContext *>(arg);
+        ctx->called = true;
+        ctx->old_endpoint_stopped = ctx->vpn->client_state == vpn_manager::CLIS_DISCONNECTED
+                && !ctx->vpn->selected_endpoint.has_value() && !ctx->vpn->pinger;
+    };
+    for (int round = 0; round < 2; ++round) {
+        context.called = false;
+        std::thread caller([&] {
+            const auto deadline = SteadyClock::now() + Secs{2};
+            while (!vpn_event_loop_is_active(vpn->ev_loop.get()) && SteadyClock::now() < deadline) {
+                std::this_thread::yield();
+            }
+            result = vpn_replace_endpoint(vpn, &replacement, commit, &context);
+        });
+        const bool reached = await_state_change(VPN_SS_RECOVERING);
+        caller.join();
+        ASSERT_TRUE(reached);
+        ASSERT_EQ(result.code, VPN_EC_NOERROR);
+        ASSERT_TRUE(context.called);
+        ASSERT_TRUE(context.old_endpoint_stopped);
+        EXPECT_EQ(vpn->ev_loop.get(), original_loop);
+        EXPECT_EQ(vpn->network_manager.get(), original_network_manager);
+        EXPECT_STREQ(vpn->upstream_config->username, "new-user");
+        EXPECT_STREQ(vpn->upstream_config->password, "new-password");
+        EXPECT_STREQ(vpn->upstream_config->location.endpoints.data[0].name, "new-server");
+        EXPECT_NE(vpn->upstream_config->location.endpoints.data, &endpoint);
+        const auto ping = g_infos[test_mock::IDX_LOCATIONS_PINGER_START].get_arg<test_mock::LocationsPingerInfo>(0);
+        ASSERT_EQ(ping->locations.size, 1u);
+        EXPECT_STREQ(ping->locations.data[0].id, "replacement");
+        // Explicit bypass remains usable while the new endpoint is unavailable.
+        VpnConnectionInfo direct{.id = uint64_t(900 + round), .action = VPN_CA_FORCE_BYPASS};
+        vpn_complete_connect_request(vpn, &direct);
+        loop_once();
+        ASSERT_FALSE(test_mock::g_client.completed_connect_requests.empty());
+        EXPECT_EQ(test_mock::g_client.completed_connect_requests.back().action, VPN_CA_FORCE_BYPASS);
+        VpnConnectionInfo protected_flow{.id = uint64_t(950 + round), .action = VPN_CA_FORCE_REDIRECT};
+        vpn_complete_connect_request(vpn, &protected_flow);
+        loop_once();
+        ASSERT_FALSE(test_mock::g_client.rejected_connect_requests.empty());
+        EXPECT_EQ(test_mock::g_client.rejected_connect_requests.back(), protected_flow.id);
